# ~/.config/pi-slack-gateway/env  (chmod 600)
# Bot User OAuth Token (OAuth & Permissions page)
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with the connections:write scope (Basic Information → App-Level Tokens)
SLACK_APP_TOKEN=xapp-...

# Optional
# LOG_LEVEL=info
# PI_SLACK_GATEWAY_CONFIG=/home/you/.config/pi-slack-gateway/config.json
# PI_SLACK_GATEWAY_STATE_DIR=/home/you/.local/state/pi-slack-gateway
# Provider credentials pi needs that are not in ~/.pi/agent (they are passed through to pi):
# ANTHROPIC_API_KEY=...
